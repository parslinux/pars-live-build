# ==============================================================================
# ParsLinux Resmi ve Yerel APT Paket Deposu Tanımı (Binary / Canlı Sistem İçi)
# Canlı sistem açıldığında /etc/apt/sources.list.d/ içine bu liste yerleşir
# ==============================================================================

deb [trusted=yes] https://parslinux.github.io/apt_repo 0.1 main
