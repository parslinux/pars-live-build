# ==============================================================================
# ParsLinux Resmi ve Yerel APT Paket Deposu Tanımı (Chroot Aşaması)
# ==============================================================================

# 1. ParsLinux Resmi APT Deposu (Varsayılan)
deb [trusted=yes] https://repo.parslinux.org/parslinux bookworm main contrib non-free

# 2. Yerel / Ağ Geliştirme Deposu (apt_dopo / repo_depo çalıştırıldığında)
# deb [trusted=yes] http://127.0.0.1:8080/parslinux bookworm main
# deb [trusted=yes] file:/packages/repo bookworm main
